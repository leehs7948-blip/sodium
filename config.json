  },
  "sodiumServer": {
    "enabled": false,
    "cwd": "./server",
    "command": "java",
    "args": [
      "-Xms2G",
      "-Xmx4G",
      "-jar",
      "server.jar",
      "nogui"
    ]
  },
  "dashboardApp": {
    "command": "node",
    "args": [
      "src/index.js"
    ],
    "cwd": "./",
    "healthTimeoutMs": 30000
